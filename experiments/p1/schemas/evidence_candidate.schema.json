{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/signbridge/p1/evidence_candidate.schema.json",
  "title": "P1 EvidenceCandidate without ground truth",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "sample_id", "model_id", "task", "sign_system", "modality", "model_revision", "preprocess_version", "window", "output", "status"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1, "default": 1},
    "window_id": {"type": ["string", "null"]},
    "model_id": {"type": "string", "minLength": 1},
    "task": {"enum": ["CSLR", "CSLT", "ISLR"]},
    "sign_system": {"enum": ["CSL", "Libras", "Unknown"]},
    "modality": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "preprocess_version": {"type": "string", "minLength": 1},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_frame", "end_frame_exclusive", "start_pts_ms", "end_pts_ms"],
      "properties": {
        "start_frame": {"type": ["integer", "null"], "minimum": 0},
        "end_frame_exclusive": {"type": ["integer", "null"], "minimum": 1},
        "start_pts_ms": {"type": ["number", "null"], "minimum": 0},
        "end_pts_ms": {"type": ["number", "null"], "minimum": 0},
        "needs_future_frames": {"type": ["boolean", "null"]}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "gloss_tokens", "text", "spoken_language"],
      "properties": {
        "kind": {"enum": ["GLOSS", "TEXT", "GESTURE_ID", "EMPTY"]},
        "gloss_tokens": {"type": ["array", "null"], "items": {"type": "string"}},
        "text": {"type": ["string", "null"]},
        "spoken_language": {"enum": ["zh", "pt", null]},
        "gesture_id": {"type": ["string", "null"]}
      }
    },
    "status": {"enum": ["OK", "FAILED", "TIMEOUT", "SKIPPED", "BLOCKED"]},
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw_score_value": {"type": ["number", "null"]},
        "raw_score_type": {"type": ["string", "null"]},
        "calibrated_reliability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "confidence_model_revision": {"type": ["string", "null"]}
      }
    }
  }
}
